      "css": ".ds-sp-nav{display:flex;gap:32px;background:var(--walnut,#4a3934);color:var(--cream,#fff6e6);font-family:Nunito,ui-rounded,sans-serif;}.ds-sp-nav a{display:flex;align-items:center;min-height:44px;font-size:16px;font-weight:750;line-height:1.65;color:inherit;text-decoration:none}.ds-sp-nav a:hover{color:var(--gold,#f2c784)}.ds-sp-nav a:focus-visible{outline:3px solid var(--gold,#f2c784);outline-offset:6px}@media(max-width:760px){.ds-sp-nav{gap:16px}.ds-sp-nav a{font-size:14px}.ds-sp-nav a:first-child{display:none}}@media(max-width:360px){.ds-sp-nav{gap:12px}.ds-sp-nav a{font-size:13px}}"
