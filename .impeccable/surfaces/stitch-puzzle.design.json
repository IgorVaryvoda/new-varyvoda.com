    {
      "name": "Welcome paper",
      "kind": "card",
      "refersTo": "welcome-paper",
      "description": "The source paper silhouette and seam. The standalone preview uses the linen fallback; production also layers the real game texture.",
      "html": "<div class=\"ds-sp-paper\"><h1>A little puzzle.<br>A little peace.</h1><p>Pull a thread. Clear the hoop.<br>Make something lovely.</p></div>",
      "css": ".ds-sp-paper{position:relative;max-width:635px;padding:48px 44px 40px;background:var(--linen,#f6eee2);color:var(--ink,#2a2420);border-radius:6px 6px 38px 6px;box-shadow:0 18px 45px #1f17174d;transform:rotate(-1.2deg);font-family:Nunito,ui-rounded,sans-serif;}.ds-sp-paper:before{content:\"\";position:absolute;inset:13px;border:1px dashed #a27b5c;border-radius:2px 2px 26px 2px;pointer-events:none}.ds-sp-paper h1{position:relative;margin:0;font-size:clamp(42px,4.8vw,68px);font-weight:850;line-height:1.08;letter-spacing:-.035em;text-wrap:balance}.ds-sp-paper p{position:relative;margin:24px 0 0;font-size:25px;font-weight:750;line-height:1.4}@media(max-width:1243px){.ds-sp-paper{padding:40px 32px}}@media(max-width:920px){.ds-sp-paper{padding:34px 28px}}@media(max-width:760px){.ds-sp-paper{transform:rotate(-.6deg)}.ds-sp-paper h1{font-size:clamp(37px,9vw,58px)}.ds-sp-paper p{font-size:22px;margin-top:20px}}@media(max-width:360px){.ds-sp-paper{padding:28px 22px}.ds-sp-paper h1{font-size:36px}}"
