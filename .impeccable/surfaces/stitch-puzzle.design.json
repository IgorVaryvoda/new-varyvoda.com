  "narrative": {
    "northStar": "A Little Craft Table",
    "overview": "This scoped identity carries the existing game's cozy craft world into its standalone lander. Walnut surrounds light linen, rounded Nunito lettering feels friendly, and real screenshots supply the visual detail. Paper, cloth, the cottage and the orange cat come from the game rather than a new illustration style.\n\nDepth comes from the physical character of a few objects: a stitched paper edge, gently tilted screens and diffuse shadows. Reading areas remain open and calm. The established craft-table language and descriptive color names are extracted from the implemented page and its direction contract; they do not introduce a new visual world.",
    "keyCharacteristics": [
      "Warm walnut and linen surfaces with clear dark-on-light or light-on-dark text.",
      "One self-hosted rounded type family with strong, compact headings.",
      "Actual game screens, game artwork and modest physical depth.",
      "Spacious prose bands and conspicuous, comfortably sized download actions."
    ],
    "rules": [
      {
        "name": "The Material Contrast Rule",
        "body": "Put dark ink on linen and cream on walnut; keep moss for actions and quiet reassurance.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use self-hosted Nunito for this lander, including its controls; do not import the personal site's display and reading type roles.",
        "section": "typography"
      },
      {
        "name": "The Physical Surface Rule",
        "body": "Use diffuse shadows for paper and real screen images; keep prose bands flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the game's real artwork and screenshots, preserving responsive images, intrinsic proportions and origin metadata.",
      "Do keep dark ink on linen and cream on walnut, with visible focus rings on both materials.",
      "Do retain the final vertical store-link stack at 480px and below and keep labels inside the paper.",
      "Do reserve diffuse shadows and static rotations for the physical paper and image objects.",
      "Do preserve support, privacy, the making-of article and both store destinations when adjusting the composition."
    ],
    "donts": [
      "Don't import the personal site's masthead, theme switch or Geologica/Literata type roles into this standalone lander.",
      "Don't replace the game's art with generic decoration or invent testimonials, ratings or product claims.",
      "Don't place notes or decoration over a screenshot caption or download control.",
      "Don't introduce automatic entrance motion or remove the existing reduced-motion behavior."
    ]
  }
}
